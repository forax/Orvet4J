<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.github.forax.ula4j</groupId>
    <artifactId>orvet</artifactId>
    <packaging>jar</packaging>
    <version>0.1</version>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Python build-standalone coordinates -->
        <python.version>3.14.10</python.version>
        <python.release>20261110</python.release>
        <python.base.url>https://github.com/astral-sh/python-build-standalone/releases/download</python.base.url>

        <micropython.version>v1.24.1</micropython.version>
        <python.platform>aarch64-apple-darwin</python.platform>

        <python.archive>cpython-${python.version}%2B${python.release}-${python.platform}-install_only.tar.gz</python.archive>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.antlr</groupId>
            <artifactId>antlr4-runtime</artifactId>
            <version>4.13.2</version>
        </dependency>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm</artifactId>
            <version>9.11.1</version>
        </dependency>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm-util</artifactId>
            <version>9.11.1</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>5.14.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <version>5.14.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <version>1.37</version>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-generator-annprocess</artifactId>
            <version>1.37</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.antlr</groupId>
                <artifactId>antlr4-maven-plugin</artifactId>
                <version>4.13.2</version>
                <configuration>
                    <visitor>false</visitor>
                    <listener>true</listener>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>antlr4</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
                <configuration>
                    <release>25</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.openjdk.jmh</groupId>
                            <artifactId>jmh-generator-annprocess</artifactId>
                            <version>1.37</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <configuration>
                    <createDependencyReducedPom>false</createDependencyReducedPom>
                    <!-- artifactSet>
                        <includes>
                            <include>org.ow2.asm:*</include>
                            <include>org.antlr:antlr4-runtime</include>
                        </includes>
                    </artifactSet -->
                    <filters>
                        <filter>
                            <artifact>*:*</artifact>
                            <excludes>
                                <exclude>META-INF/MANIFEST.MF</exclude>
                                <exclude>**/module-info.class</exclude>
                            </excludes>
                        </filter>
                    </filters>
                    <transformers>
                        <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                            <mainClass>com.github.forax.orvet.Main</mainClass>
                        </transformer>
                        <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                    </transformers>
                </configuration>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.0</version>
            </plugin>

        </plugins>
    </build>


    <profiles>
        <profile>
            <id>python-linux-x86_64</id>
            <activation>
                <os>
                    <name>Linux</name>
                    <arch>amd64</arch>
                </os>
            </activation>
            <properties>
                <python.archive>cpython-${python.version}%2B${python.release}-x86_64-unknown-linux-gnu-install_only.tar.gz</python.archive>
            </properties>
        </profile>

        <profile>
            <id>python-linux-aarch64</id>
            <activation>
                <os>
                    <name>Linux</name>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <properties>
                <python.archive>cpython-${python.version}%2B${python.release}-aarch64-unknown-linux-gnu-install_only.tar.gz</python.archive>
            </properties>
        </profile>

        <profile>
            <id>python-macos-x86_64</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>x86_64</arch>
                </os>
            </activation>
            <properties>
                <python.archive>cpython-${python.version}%2B${python.release}-x86_64-apple-darwin-install_only.tar.gz</python.archive>
            </properties>
        </profile>

        <profile>
            <id>python-macos-aarch64</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <properties>
                <python.archive>cpython-${python.version}%2B${python.release}-aarch64-apple-darwin-install_only.tar.gz</python.archive>
            </properties>
        </profile>

        <profile>
            <id>update-corpus</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.googlecode.maven-download-plugin</groupId>
                        <artifactId>download-maven-plugin</artifactId>
                        <version>1.13.0</version>
                        <executions>
                            <execution>
                                <id>download-python</id>
                                <phase>initialize</phase>
                                <goals><goal>wget</goal></goals>
                                <configuration>
                                    <url>${python.base.url}/${python.release}/${python.archive}</url>
                                    <outputDirectory>${project.build.directory}</outputDirectory>
                                    <outputFileName>python-${python.version}.tar.gz</outputFileName>
                                    <overwrite>false</overwrite>
                                    <unpack>false</unpack>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.3.0</version>
                        <executions>
                            <execution>
                                <id>update-micropython-corpus</id>
                                <phase>generate-test-resources</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>-c</argument>
                                        <argument>
                                            set -euo pipefail

                                            ROOT="${project.basedir}"
                                            BUILD="${project.build.directory}"
                                            MP="$BUILD/micropython"
                                            SOURCE="$MP/tests/basics"
                                            CORPUS="$ROOT/src/test/resources/micropython/basics"
                                            PYTHON="$BUILD/python/bin/python3"
                                            ARCHIVE="$BUILD/python-${python.version}.tar.gz"

                                            echo "Cloning MicroPython ${micropython.version}..."

                                            rm -rf "$MP"

                                            git clone --depth 1 --filter=blob:none --sparse \
                                            --branch "${micropython.version}" \
                                            https://github.com/micropython/micropython.git \
                                            "$MP"

                                            git -C "$MP" sparse-checkout set tests/basics

                                            echo "Extracting Python ${python.version}..."

                                            rm -rf "$BUILD/python"
                                            tar -xzf "$ARCHIVE" -C "$BUILD"

                                            if [ ! -x "$PYTHON" ]; then
                                            echo "Python executable not found: $PYTHON" >&amp;2
                                            exit 1
                                            fi

                                            echo "Replacing MicroPython basics corpus..."

                                            mkdir -p "$(dirname "$CORPUS")"
                                            rm -rf "$CORPUS"
                                            mkdir -p "$CORPUS"

                                            cp -R "$SOURCE/." "$CORPUS/"

                                            echo "Generating golden files..."

                                            "$PYTHON" \
                                            "$ROOT/src/test/scripts/generate_golden.py" \
                                            "$CORPUS"

                                            echo "Corpus update completed successfully."
                                        </argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>